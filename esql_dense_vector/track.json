{% set p_source = source | default("index") %}
{% set p_sizes = sizes | default([1, 10, 100, 1000, 10000]) %}
{% set p_inference_id = inference_id | default("esql-dv-benc-e5") %}
{% set p_create_e5_endpoint = create_e5_endpoint | default(true) %}
{% set p_null_check = null_check | default(true) %}
{% set p_gate_rows = null_check_gate_rows | default(100) %}
{% set p_index = index_name | default("msmarco_local") %}
{% set p_dataset = dataset | default("msmarco_s3") %}
{% set p_data_source = data_source | default("msmarco_src") %}
{% set p_from = p_index if p_source == "index" else p_dataset %}
{% set p_reference_doc_id = reference_doc_id | default("00_0") %}
{% set p_reference_name = p_source ~ "-" ~ p_reference_doc_id %}
{% set p_reference_min_similarity = reference_min_similarity | default(0.9999) %}
{% set p_knn_similarity = knn_similarity | default(0.6) %}
{
  "version": 2,
  "description": "ES|QL DENSE_VECTOR embedding cost over msmarco-v2 passages read from an index or from an S3 dataset",
  {% if p_source == "index" %}
  "indices": [
    {
      "name": "{{ p_index }}",
      "body": "index.json"
    }
  ],
  "corpora": [
    {
      "name": "msmarco-10k",
      "base-url": "{{ corpus_base_url | default('s3://lz-esql-dense-vector-eu-central-1/msmarco/10k/ndjson') }}",
      "documents": [
        {
          "source-file": "msmarco_10k.ndjson",
          "document-count": 10000,
          "uncompressed-bytes": 3275503,
          "target-index": "{{ p_index }}"
        }
      ]
    }
  ],
  {% endif %}
  "challenges": [
    {% for challenge_name, shape, with_profile in [("embed", "embed", false), ("embed-profiled", "embed", true), ("cosine-profiled", "cosine", true), ("knn-profiled", "knn", true)] %}
    {
      "name": "{{ challenge_name }}",
      "default": {{ "true" if challenge_name == "embed" else "false" }},
      {% if challenge_name == "embed-profiled" %}
      "description": "embed, plus profile warm-up and profile_iterations runs of each size with the ES|QL profile on, after its measured runs",
      {% elif challenge_name == "cosine-profiled" %}
      "description": "FROM <source> | LIMIT n | DENSE_VECTOR dv = text | EVAL sim = v_cosine(<reference vector>, dv) | KEEP id, sim for each n, with a correctness gate and profiled runs",
      {% elif challenge_name == "knn-profiled" %}
      "description": "FROM <source> | LIMIT n | DENSE_VECTOR vec = text | WHERE knn(vec, <reference vector>, {similarity}) | KEEP id for each n, with a correctness gate, profiled runs and returned-row counts",
      {% else %}
      "description": "FROM <source> | LIMIT n | DENSE_VECTOR emb = text | KEEP id, emb for each n in sizes, one client",
      {% endif %}
      "schedule": [
        {
          "operation": {
            "name": "raise-dense-vector-limit",
            "operation-type": "put-settings",
            "body": {
              "persistent": {
                "esql.command.dense_vector.limit": {{ p_sizes | max }}
              }
            }
          }
        },
        {% if p_source == "index" %}
        {
          "operation": {
            "name": "delete-index",
            "operation-type": "delete-index"
          }
        },
        {
          "operation": {
            "name": "create-index",
            "operation-type": "create-index"
          }
        },
        {
          "operation": {
            "name": "check-cluster-health",
            "operation-type": "cluster-health",
            "request-params": {
              "wait_for_status": "green"
            },
            "retry-until-success": true
          }
        },
        {
          "operation": {
            "name": "index-documents",
            "operation-type": "bulk",
            "bulk-size": {{ bulk_size | default(1000) }}
          },
          "clients": 1
        },
        {
          "operation": {
            "name": "refresh-after-index",
            "operation-type": "refresh"
          }
        },
        {% else %}
        {
          "operation": {
            "name": "enable-managed-identity",
            "operation-type": "put-settings",
            "body": {
              "persistent": {
                "esql.external.managed_identity.enabled": true
              }
            }
          }
        },
        {
          "operation": {
            "name": "delete-dataset",
            "operation-type": "raw-request",
            "method": "DELETE",
            "path": "/_query/dataset/{{ p_dataset }}",
            "ignore": [404],
            "include-in-reporting": false
          }
        },
        {
          "operation": {
            "name": "delete-data-source",
            "operation-type": "raw-request",
            "method": "DELETE",
            "path": "/_query/data_source/{{ p_data_source }}",
            "ignore": [404],
            "include-in-reporting": false
          }
        },
        {
          "operation": {
            "name": "put-data-source",
            "operation-type": "raw-request",
            "method": "PUT",
            "path": "/_query/data_source/{{ p_data_source }}",
            "body": {
              "type": "s3",
              "settings": {
                "auth": "managed_identity"
              }
            },
            "include-in-reporting": false
          }
        },
        {
          "operation": {
            "name": "put-dataset",
            "operation-type": "raw-request",
            "method": "PUT",
            "path": "/_query/dataset/{{ p_dataset }}",
            "body": {
              "data_source": "{{ p_data_source }}",
              "resource": "{{ dataset_resource | default('s3://lz-esql-dense-vector-eu-central-1/msmarco/10k/parquet/msmarco_10k.parquet') }}",
              "settings": {
                "region": "{{ s3_region | default('eu-central-1') }}"
              }
            },
            "include-in-reporting": false
          }
        },
        {% endif %}
        {% if p_create_e5_endpoint %}
        {
          "operation": {
            "name": "delete-inference-endpoint",
            "operation-type": "raw-request",
            "method": "DELETE",
            "path": "/_inference/{{ p_inference_id }}",
            "request-params": {
              "force": "true"
            },
            "ignore": [404],
            "include-in-reporting": false
          }
        },
        {
          "operation": {
            "name": "create-inference-endpoint",
            "operation-type": "create-inference-endpoint",
            "task-type": "text_embedding",
            "inference-id": "{{ p_inference_id }}",
            "request-params": {
              "timeout": "{{ create_endpoint_timeout | default('5m') }}"
            },
            "request-timeout": {{ create_endpoint_request_timeout | default(360) }},
            "retries": {{ create_endpoint_retries | default(10) }},
            "retry-wait-period": {{ create_endpoint_retry_wait | default(30) }},
            "body": {
              "service": "elasticsearch",
              "service_settings": {
                "model_id": "{{ e5_model_id | default('.multilingual-e5-small_linux-x86_64') }}",
                "num_threads": {{ e5_num_threads | default(1) }},
                "adaptive_allocations": {
                  "enabled": true,
                  "min_number_of_allocations": {{ e5_min_allocations | default(0) }},
                  "max_number_of_allocations": {{ e5_max_allocations | default(32) }}
                }
              },
              "chunking_settings": {
                "strategy": "sentence",
                "max_chunk_size": 250,
                "sentence_overlap": 1
              }
            },
            "include-in-reporting": false
          }
        },
        {% endif %}
        {
          "operation": {
            "name": "wait-for-inference-endpoint",
            "operation-type": "wait-for-inference-endpoint",
            "inference-id": "{{ p_inference_id }}",
            "request-timeout": 300,
            "retries": {{ wait_for_endpoint_retries | default(10) }},
            "retry-wait-period": {{ wait_for_endpoint_retry_wait | default(30) }},
            "include-in-reporting": false
          }
        },
        {% if p_null_check %}
        {
          "operation": {
            "name": "null-check-gate",
            "operation-type": "dense-vector-null-check",
            "query": "FROM {{ p_from }} | LIMIT {{ p_gate_rows }} | DENSE_VECTOR emb = text WITH {\"inference_id\": \"{{ p_inference_id }}\"} | EVAL is_null = CASE(emb IS NULL, 1, 0) | STATS row_count = COUNT(*), null_count = SUM(is_null)",
            "expected-rows": {{ p_gate_rows }},
            "request-timeout": {{ request_timeout | default(600) }}
          },
          "clients": 1,
          "warmup-iterations": 0,
          "iterations": 1
        },
        {% endif %}
        {% if shape != "embed" %}
        {
          "operation": {
            "name": "compute-reference-vector",
            "operation-type": "compute-reference-vector",
            "reference-name": "{{ p_reference_name }}",
            "query": "FROM {{ p_from }} | WHERE id == \"{{ p_reference_doc_id }}\" | DENSE_VECTOR emb = text WITH {\"inference_id\": \"{{ p_inference_id }}\"} | KEEP emb",
            "request-timeout": {{ request_timeout | default(600) }},
            "include-in-reporting": false
          }
        },
        {
          "operation": {
            "name": "correctness-gate",
            "operation-type": "reference-vector-correctness",
            "reference-name": "{{ p_reference_name }}",
            {% if shape == "cosine" %}
            "check": "cosine",
            "min-similarity": {{ p_reference_min_similarity }},
            "query": "FROM {{ p_from }} | WHERE id == \"{{ p_reference_doc_id }}\" | DENSE_VECTOR dv = text WITH {\"inference_id\": \"{{ p_inference_id }}\"} | EVAL sim = v_cosine(__REFERENCE_VECTOR__, dv) | KEEP id, sim",
            {% else %}
            "check": "present",
            "expected-id": "{{ p_reference_doc_id }}",
            "body": {"pragma": {"knn_runtime_field": true}},
            "query": "FROM {{ p_from }} | WHERE id == \"{{ p_reference_doc_id }}\" | DENSE_VECTOR vec = text WITH {\"inference_id\": \"{{ p_inference_id }}\"} | WHERE knn(vec, __REFERENCE_VECTOR__, {\"similarity\": {{ p_knn_similarity }} }) | KEEP id",
            {% endif %}
            "request-timeout": {{ request_timeout | default(600) }}
          },
          "clients": 1,
          "warmup-iterations": 0,
          "iterations": 1
        },
        {% endif %}
        {% for n in p_sizes %}
        {
          "operation": {
            "name": "{{ shape }}-{{ n }}",
            {% if shape == "embed" %}
            "operation-type": "esql",
            "query": "FROM {{ p_from }} | LIMIT {{ n }} | DENSE_VECTOR emb = text WITH {\"inference_id\": \"{{ p_inference_id }}\"} | KEEP id, emb",
            {% elif shape == "cosine" %}
            "operation-type": "esql-with-reference-vector",
            "reference-name": "{{ p_reference_name }}",
            "query": "FROM {{ p_from }} | LIMIT {{ n }} | DENSE_VECTOR dv = text WITH {\"inference_id\": \"{{ p_inference_id }}\"} | EVAL sim = v_cosine(__REFERENCE_VECTOR__, dv) | KEEP id, sim",
            {% else %}
            "operation-type": "esql-with-reference-vector",
            "reference-name": "{{ p_reference_name }}",
            "body": {"pragma": {"knn_runtime_field": true}},
            "query": "FROM {{ p_from }} | LIMIT {{ n }} | DENSE_VECTOR vec = text WITH {\"inference_id\": \"{{ p_inference_id }}\"} | WHERE knn(vec, __REFERENCE_VECTOR__, {\"similarity\": {{ p_knn_similarity }} }) | KEEP id",
            {% endif %}
            "detailed-results": true,
            "request-timeout": {{ request_timeout | default(600) }}
          },
          "clients": 1,
          "warmup-iterations": {{ warmup_iterations | default(2) }},
          "iterations": {{ iterations | default(10) }}
        }{% if with_profile %},
        {
          "operation": {
            "name": "{{ shape }}-{{ n }}-profile",
            {% if shape == "embed" %}
            "operation-type": "esql-profile",
            "query": "FROM {{ p_from }} | LIMIT {{ n }} | DENSE_VECTOR emb = text WITH {\"inference_id\": \"{{ p_inference_id }}\"} | KEEP id, emb",
            {% elif shape == "cosine" %}
            "operation-type": "esql-profile-with-reference-vector",
            "reference-name": "{{ p_reference_name }}",
            "query": "FROM {{ p_from }} | LIMIT {{ n }} | DENSE_VECTOR dv = text WITH {\"inference_id\": \"{{ p_inference_id }}\"} | EVAL sim = v_cosine(__REFERENCE_VECTOR__, dv) | KEEP id, sim",
            {% else %}
            "operation-type": "esql-profile-with-reference-vector",
            "reference-name": "{{ p_reference_name }}",
            "body": {"pragma": {"knn_runtime_field": true}},
            "query": "FROM {{ p_from }} | LIMIT {{ n }} | DENSE_VECTOR vec = text WITH {\"inference_id\": \"{{ p_inference_id }}\"} | WHERE knn(vec, __REFERENCE_VECTOR__, {\"similarity\": {{ p_knn_similarity }} }) | KEEP id",
            {% endif %}
            "request-timeout": {{ request_timeout | default(600) }}
          },
          "clients": 1,
          "warmup-iterations": {{ profile_warmup_iterations | default(warmup_iterations | default(2)) }},
          "iterations": {{ profile_iterations | default(10) }}
        }{% endif %}{% if p_null_check %},
        {
          "operation": {
            "name": "null-check-{{ n }}",
            "operation-type": "dense-vector-null-check",
            "query": "FROM {{ p_from }} | LIMIT {{ n }} | DENSE_VECTOR emb = text WITH {\"inference_id\": \"{{ p_inference_id }}\"} | EVAL is_null = CASE(emb IS NULL, 1, 0) | STATS row_count = COUNT(*), null_count = SUM(is_null)",
            "expected-rows": {{ n }},
            "request-timeout": {{ request_timeout | default(600) }}
          },
          "clients": 1,
          "warmup-iterations": 0,
          "iterations": 1
        }{% endif %}{% if shape == "knn" %},
        {
          "operation": {
            "name": "knn-rows-{{ n }}",
            "operation-type": "esql-stats-with-reference-vector",
            "reference-name": "{{ p_reference_name }}",
            "body": {"pragma": {"knn_runtime_field": true}},
            "query": "FROM {{ p_from }} | LIMIT {{ n }} | DENSE_VECTOR vec = text WITH {\"inference_id\": \"{{ p_inference_id }}\"} | WHERE knn(vec, __REFERENCE_VECTOR__, {\"similarity\": {{ p_knn_similarity }} }) | LIMIT {{ n }} | STATS returned_rows = COUNT(*)",
            "request-timeout": {{ request_timeout | default(600) }}
          },
          "clients": 1,
          "warmup-iterations": 0,
          "iterations": 1
        }{% endif %}{{ "," if not loop.last }}
        {% endfor %}
      ]
    }{{ "," if not loop.last }}
    {% endfor %}
  ]
}
